#!/bin/bash
set -euo pipefail

apt-get update
apt-get install -y docker.io docker-compose-v2
systemctl enable --now docker
hostnamectl set-hostname kanshi-server

install -d -m 0755 /opt/kanshi
cd /opt/kanshi

cat > docker-compose.yaml <<'COMPOSE'
${compose_file_content}
COMPOSE

cat > otel-collector.yaml <<'COLLECTOR'
${collector_file_content}
COLLECTOR

cat > .env <<'ENV'
CORE_VERSION=${core_version}
DASHBOARD_VERSION=${dashboard_version}
DASHBOARD_PORT=80
DB_PASSWORD=${db_password}
KANSHI_API_KEY=${api_key}
KANSHI_DASHBOARD_KEY=${dashboard_key}
KANSHI_WEBHOOK_SECRET=${webhook_secret}
ENV
chmod 0600 .env

docker compose up -d

curl -fsSL https://kanshi.dev/install.sh |
  KANSHI_VERSION="${agent_version}" \
  KANSHI_CORE_ADDR="127.0.0.1:50051" \
  KANSHI_API_KEY="${api_key}" \
  KANSHI_PROCESS_METRICS="true" \
  sh -s -- --systemd
