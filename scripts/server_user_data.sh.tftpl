#!/bin/bash
set -euo pipefail

apt-get update
apt-get install -y curl docker.io docker-compose-v2
systemctl enable --now docker

install -d -m 0755 /opt/kanshi
cd /opt/kanshi

cat > docker-compose.yaml <<'COMPOSE'
${compose_file_content}
COMPOSE

cat > otel-collector.yaml <<'COLLECTOR'
${collector_file_content}
COLLECTOR

curl --fail --location --output demo.py \
  https://raw.githubusercontent.com/kanshi-dev/demo/6ccfc06c02fc2ea3317a25f16ad2a3359d95436d/demo.py

cat > .env <<'ENV'
CORE_VERSION=${core_version}
DASHBOARD_VERSION=${dashboard_version}
DASHBOARD_PORT=80
DB_PASSWORD=${db_password}
KANSHI_API_KEY=${api_key}
KANSHI_DASHBOARD_KEY=${dashboard_key}
KANSHI_WEBHOOK_SECRET=${webhook_secret}
ENV
chmod 0600 .env

docker compose up -d
