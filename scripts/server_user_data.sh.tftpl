#!/bin/bash
set -euo pipefail

apt-get update
apt-get install -y curl docker.io docker-compose-v2
systemctl enable --now docker

install -d -m 0755 /opt/kanshi
cd /opt/kanshi

cat > docker-compose.yaml <<'COMPOSE'
${compose_file_content}
COMPOSE

cat > otel-collector.yaml <<'COLLECTOR'
${collector_file_content}
COLLECTOR

cat > alert-sink.py <<'ALERT_SINK'
${alert_sink_file_content}
ALERT_SINK

curl --fail --location --output demo-driver.sh \
  https://raw.githubusercontent.com/kanshi-dev/demo/a106fe348628dfebd7819e8b32554de46b668bc7/demo-driver.sh
chmod 0755 demo-driver.sh

cat > .env <<'ENV'
CORE_VERSION=${core_version}
DASHBOARD_VERSION=${dashboard_version}
DASHBOARD_PORT=80
DB_PASSWORD=${db_password}
KANSHI_API_KEY=${api_key}
KANSHI_DASHBOARD_KEY=${dashboard_key}
KANSHI_WEBHOOK_SECRET=${webhook_secret}
ENV
chmod 0600 .env

docker compose up -d
